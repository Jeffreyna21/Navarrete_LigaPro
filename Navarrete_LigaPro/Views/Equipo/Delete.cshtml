@model Navarrete_LigaPro.Models.Equipo

@{
    ViewData["Title"] = "Delete";
}
<style>
    /* Estilo general */
    body {
        background-color: #f4f4f4;
        font-family: 'Arial', sans-serif;
        color: #333;
    }

    h1 {
        text-align: center;
        font-size: 2.5rem;
        color: #dc3545; /* Rojo para eliminar */
        font-weight: bold;
        margin-top: 30px;
    }

    h3 {
        text-align: center;
        color: #1d3c6e; /* Azul oscuro */
        font-size: 1.8rem;
    }

    /* Contenedor principal */
    .container {
        background-color: #ffffff;
        padding: 30px;
        margin-top: 30px;
        border-radius: 10px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
    }

    /* Lista de detalles */
    dl.row {
        font-size: 1.1rem;
    }

    dt {
        font-weight: bold;
        color: #1d3c6e; /* Azul de equipo */
    }

    dd {
        font-weight: normal;
        color: #555;
    }

    .btn-danger {
        background-color: #dc3545;
        color: white;
        font-weight: bold;
        padding: 12px 25px;
        border-radius: 5px;
        text-decoration: none;
    }

        .btn-danger:hover {
            background-color: #c82333;
        }

    .btn-back {
        font-size: 1.1rem;
        color: #007bff;
        text-decoration: none;
        font-weight: bold;
        padding: 10px 20px;
        border-radius: 5px;
    }

        .btn-back:hover {
            text-decoration: underline;
        }

    .text-center {
        margin-top: 20px;
    }
</style>

<h1>Delete</h1>

<h3>Estas seguro que quieres eliminar este equipo?</h3>
<div>
    <h4>Equipo</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Id)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Id)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.partidosJugados)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.partidosJugados)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.partidosGanados)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.partidosGanados)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.partidosEmpatados)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.partidosEmpatados)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.partidosPerdidos)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.partidosPerdidos)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Puntos)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Puntos)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a href="@Url.Action("List")" class="btn btn-primary">Volver al listado</a
    </form>